cabal-version: 1.12
name:           haskell-routing-service
version:        0.1.0.0
synopsis:       Intelligent pure functional payment routing rules engine
license:        MIT
build-type:     Simple

library
  exposed-modules:
      Types
      RulesEngine
  other-modules:
      Paths_haskell_routing_service
  hs-source-dirs:
      src
  build-depends:
      aeson >=2.0
    , base >=4.7 && <5
    , http-types >=0.12
    , scotty >=0.12
    , text >=1.2
    , time >=1.9
    , wai >=3.2
    , wai-cors >=0.2
  default-language: Haskell2010

executable haskell-routing-service-exe
  main-is: Main.hs
  other-modules:
      Paths_haskell_routing_service
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      aeson >=2.0
    , base >=4.7 && <5
    , haskell-routing-service
    , http-types >=0.12
    , scotty >=0.12
    , text >=1.2
    , time >=1.9
    , wai >=3.2
    , wai-cors >=0.2
  default-language: Haskell2010
