# Environment Configuration Example for PayRoute

# PostgreSQL Database
POSTGRES_DB=payroute_db
POSTGRES_USER=payroute
POSTGRES_PASSWORD=payroute_secret
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Haskell Rules Service
HASKELL_SERVICE_URL=http://haskell-service:8081

# JWT Secret (Base64 or 256-bit secure secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Backend Server
PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Frontend Server
NEXT_PUBLIC_API_URL=http://localhost:8080/api
